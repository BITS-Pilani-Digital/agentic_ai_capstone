# ThreadWise AI Learning Companion - environment template
#
# Copy to .env for local use:   cp .env.example .env
# .env is git-ignored. This file must contain placeholders only - never real values.
#
# Secrets belong in GitHub Codespaces secrets (development) or restricted server
# configuration outside the repository (deployment). Values below marked "SECRET"
# must never be committed, pasted into issues, or written to logs.
#
# No application code reads these yet. Names may be refined while building week-01;
# update this file and docs/requirements.md together when they change.

# --- Generation: Groq free tier only (no paid model fallback) ---------------
# SECRET. Store as the Codespaces secret GROQ_API_KEY; do not put a real key here.
GROQ_API_KEY=replace-with-your-groq-api-key
# Single supported generation model.
GROQ_MODEL=openai/gpt-oss-20b

# --- Embeddings: local model, 384 dimensions --------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Pin the exact model revision after the encoder check (docs/backlog.md PREP-08).
EMBEDDING_MODEL_REVISION=replace-with-pinned-revision

# --- PostgreSQL with pgvector (local container) ------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=threadwise
POSTGRES_USER=threadwise
# SECRET. Choose a local development password; use a different one on the server.
POSTGRES_PASSWORD=replace-with-local-dev-password
# Application role used by the app (read/write) and by the MCP server (read-only).
# Roles and passwords are defined in week-01 migrations (docs/backlog.md W1-02).
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/threadwise
MCP_DATABASE_URL=postgresql://READONLY_USER:PASSWORD@db:5432/threadwise

# --- Authentication: Amazon Cognito through Streamlit OIDC ------------------
# Validated in week-01 (W1-09); the exact Streamlit configuration is decided then.
COGNITO_REGION=replace-with-aws-region
COGNITO_USER_POOL_ID=replace-with-user-pool-id
COGNITO_CLIENT_ID=replace-with-app-client-id
# SECRET.
COGNITO_CLIENT_SECRET=replace-with-app-client-secret
COGNITO_SERVER_METADATA_URL=replace-with-oidc-discovery-url
OIDC_REDIRECT_URI=http://localhost:8501/oauth2callback
# SECRET. Random string used to sign the session cookie.
OIDC_COOKIE_SECRET=replace-with-random-string

# --- Application ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- AWS (operator environment only) ----------------------------------------
# The runtime needs no S3 credentials for routine queries. Operators upload packs and
# backups with short-lived credentials from their own environment. Do NOT add AWS
# access keys to this file or to the repository.
AWS_REGION=replace-with-aws-region
S3_BUCKET=replace-with-private-bucket-name
